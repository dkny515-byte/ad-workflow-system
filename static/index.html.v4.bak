        function generateId(customer, projectName) {
            const now = new Date();
            const date = `${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}${String(now.getDate()).padStart(2,'0')}`;
            const short = customer.slice(0, 4);
            const seq = String(orders.length + 1).padStart(3, '0');
            return `${short}-${date}-${seq}`;
        }

        function showToast(msg) {
            const existing = document.querySelector('.toast');
            if (existing) existing.remove();
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2500);
        }

        // ==================== 界面渲染 ====================
        function render() {
            const content = document.getElementById('content');
            content.innerHTML = '';
            
            switch(currentTab) {
                case 'create': renderCreate(content); break;
                case 'copywriter': renderCopywriter(content); break;
                case 'designer': renderDesigner(content); break;
                case 'review': renderReview(content); break;
                case 'feedback': renderFeedback(content); break;
                case 'kanban': renderKanban(content); break;
                case 'summary': renderSummary(content); break;
                case 'admin': renderAdmin(content); break;
            }
        }

        // AE下单页
        function renderCreate(container) {
            const now = new Date();
            const today = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
            container.innerHTML = `
                <div class="card">
                    <div class="card-title">📝 新建工单</div>
                    <form id="createForm">
                        <div class="form-group">
                            <label class="form-label">工作性质 <span class="required">*</span></label>
                            <div class="radio-group" id="workTypeGroup">
                                <div class="radio-item selected" data-value="原创">原创</div>
                                <div class="radio-item" data-value="延展">延展</div>
                                <div class="radio-item" data-value="修改">修改</div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">项目简述 <span class="required">*</span></label>
                            <input type="text" id="projectName" placeholder="如：端午理财海报" required>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">客户 <span class="required">*</span></label>
                                <select id="customer" required>
                                    <option value="">选择客户</option>
                                    ${CUSTOMERS_DATA.map(c => `<option value="${c.name}">${c.name}</option>`).join('')}
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">部门</label>
                                <select id="dept">
                                    <option value="">先选择客户</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">下单人</label>
                            <input type="text" id="orderPerson" placeholder="客户侧具体联系人">
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">下单日期 <span class="required">*</span></label>
                                <input type="date" id="orderDate" value="${today}" required>
                                <div class="form-hint">默认为今天，支持补录历史工单</div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">计划交付日期 <span class="required">*</span></label>
                                <input type="date" id="planDate" required>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">制作日期</label>
                                <input type="date" id="makeDate">
                                <div class="form-hint">用于排班看板，不填则待分配</div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">优先级</label>
                                <div class="radio-group" id="priorityGroup">
                                    <div class="radio-item selected" data-value="P0">P0</div>
                                    <div class="radio-item" data-value="P1">P1</div>
                                    <div class="radio-item" data-value="P2">P2</div>
                                    <div class="radio-item" data-value="P3">P3</div>
                                    <div class="radio-item" data-value="可能来">可能来</div>
                                    <div class="radio-item" data-value="当天新增">当天新增</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="section-divider"></div>
                        
                        <div class="form-group">
                            <label class="form-label">交付物类型</label>
                            <input type="text" id="deliverType" placeholder="海报、易拉宝、长图、banner、主KV等">
                            <div class="form-hint">填写具体类型，如：海报</div>
                        </div>
                        
                        <div class="form-row-3">
                            <div class="form-group">
                                <label class="form-label">规格尺寸</label>
                                <input type="text" id="size" placeholder="1080×1920">
                            </div>
                            <div class="form-group">
                                <label class="form-label">数量</label>
                                <input type="number" id="quantity" value="1" min="1">
                            </div>
                            <div class="form-group">
                                <label class="form-label">单位</label>
                                <input type="text" id="unit" placeholder="个、件、项、页" value="个">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">说明</label>
                            <textarea id="desc" placeholder="详细设计要求，如风格、色调、重点内容等"></textarea>
                        </div>
                        
                        <div class="section-divider"></div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">需要前策/文案</label>
                                <div class="radio-group" id="needCopyGroup">
                                    <div class="radio-item selected" data-value="false">否</div>
                                    <div class="radio-item" data-value="true">是</div>
                                </div>
                            </div>
                            <div class="form-group" id="copywriterGroup" style="display:none">
                                <label class="form-label">前策/文案人员</label>
                                <select id="copywriter">
                                    <option value="">选择人员</option>
                                    ${OTHER_STAFF.map(d => `<option value="${d}">${d}</option>`).join('')}
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">分配设计师</label>
                            <select id="designer">
                                <option value="">待分配</option>
                                ${DESIGNERS.map(d => `<option value="${d}">${d}</option>`).join('')}
                            </select>
                            <div class="form-hint">不填则进入排班看板待分配</div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">指定内审员</label>
                            <select id="reviewer">
                                <option value="">自动分配</option>
                                ${REVIEWERS.map(r => `<option value="${r}">${r}</option>`).join('')}
                            </select>
                        </div>
                        
                
                        
                        <button type="submit" class="btn btn-primary" style="width:100%;margin-top:8px">提交工单</button>
                        
                        <div class="form-hint" style="margin-top:12px;text-align:center">
                            提交后自动生成：项目编号、看板名称、看板备注、版本号(v1)
                        </div>
                    </form>
                </div>
            `;
            
            document.getElementById('customer').addEventListener('change', function() {
                const customer = CUSTOMERS_DATA.find(c => c.name === this.value);
                const deptSelect = document.getElementById('dept');
                if (customer) {
                    deptSelect.innerHTML = customer.depts.map(d => `<option value="${d}">${d}</option>`).join('');
                } else {
                    deptSelect.innerHTML = '<option value="">先选择客户</option>';
                }
            });
            
            document.querySelectorAll('.radio-group').forEach(group => {
                group.addEventListener('click', function(e) {
                    if (e.target.classList.contains('radio-item')) {
                        this.querySelectorAll('.radio-item').forEach(item => item.classList.remove('selected'));
                        e.target.classList.add('selected');
                        if (this.id === 'needCopyGroup') {
                            const show = e.target.dataset.value === 'true';
                            document.getElementById('copywriterGroup').style.display = show ? 'block' : 'none';
                        }
                    }
                });
            });
            
            document.getElementById('createForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const customer = document.getElementById('customer').value;
                const projectName = document.getElementById('projectName').value;
                
                if (!customer || !projectName || !document.getElementById('planDate').value) {
                    showToast('请填写必填项');
                    return;
                }
                
                const workType = document.querySelector('#workTypeGroup .selected').dataset.value;
                const priority = document.querySelector('#priorityGroup .selected').dataset.value;
                const needCopy = document.querySelector('#needCopyGroup .selected').dataset.value === 'true';
                const designer = document.getElementById('designer').value;
                
                const order = {
                    projectName: projectName,
                    workType: workType,
                    customer: customer,
                    dept: document.getElementById('dept').value,
                    orderPerson: document.getElementById('orderPerson').value,
                    orderDate: document.getElementById('orderDate').value,
                    planDate: document.getElementById('planDate').value,
                    makeDate: document.getElementById('makeDate').value || null,
                    priority: priority,
                    deliverType: document.getElementById('deliverType').value,
                    size: document.getElementById('size').value,
                    quantity: parseInt(document.getElementById('quantity').value) || 1,
                    unit: document.getElementById('unit').value,
                    desc: document.getElementById('desc').value,
                    designer: designer,
                    needCopy: needCopy,
                    copywriter: needCopy ? document.getElementById('copywriter').value : '',
                    reviewer: document.getElementById('reviewer').value || REVIEWERS[0]
                };
                
                try {
                    showToast('正在创建工单...');
                    const result = await apiPost('/api/orders/', order);
                    orders.push(result);
                    showToast('工单创建成功！');
                    this.reset();
                    document.querySelectorAll('.radio-group .radio-item:first-child').forEach(item => item.classList.add('selected'));
                    document.getElementById('orderDate').value = today;
                    render();
                } catch (e) {
                    showToast('创建失败: ' + e.message);
                }
            });
        }

        // 前策工作台
        function renderCopywriter(container) {
            const copyOrders = orders.filter(o => o.status === 'pending_copy'); // 演示模式：显示所有待文案工单
            
            if (copyOrders.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="icon">📝</div>
                        <div>暂无待处理的文案工单</div>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = `
                <div style="margin-bottom:12px;font-size:13px;color:#646a73">
                    待处理文案: ${copyOrders.length}件
                </div>
                ${copyOrders.map(order => `
                    <div class="order-card status-pending">
                        <div class="order-header">
                            <div>
                                <div class="order-name">【${order.workType}】${order.projectName}</div>
                                <div style="margin-top:4px">
                                    <span class="tag tag-p0">${order.priority}</span>
                                    <span class="tag-status status-pending">待文案</span>
                                </div>
                            </div>
                        </div>
                        <div class="order-meta">
                            <div>客户：${order.customer} · ${order.dept}</div>
                            <div>AE：${order.ae}</div>
                            <div>说明：${order.desc || '无'}</div>
                        </div>
                        <div class="form-group" style="margin-top:12px">
                            <label class="form-label">文案内容</label>
                            <textarea id="copyContent_${order.id}" rows="4" placeholder="输入文案内容...">${order.copyContent || ''}</textarea>
                        </div>
                        <div class="order-actions">
                            <button class="btn btn-primary btn-sm" onclick="submitCopy('${order.id}')">提交文案，进入设计</button>
                        </div>
                    </div>
                `).join('')}
            `;
        }

        // 设计师工作台
        function renderDesigner(container) {
            const myOrders = orders.filter(o => o.status !== 'done' && o.status !== 'cancelled' && o.status !== 'pending_copy');
            
            if (myOrders.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="icon">🎨</div>
                        <div>暂无进行中的工单</div>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = `
                <div style="margin-bottom:12px;font-size:13px;color:#646a73">
                    进行中: ${myOrders.length}件
                </div>
                ${myOrders.map(order => {
                    const statusLabels = {
                        'pending': '待分配',
                        'designing': '设计中',
                        'review': '待内审',
                        'client': '提交客户',
                        'revise': '客户修改'
                    };
                    const statusClasses = {
                        'pending': 'status-pending',
                        'designing': 'status-designing',
                        'review': 'status-review',
                        'client': 'status-client',
                        'revise': 'status-revise'
                    };
                    const priorityTags = {
                        'P0': 'tag-p0', 'P1': 'tag-p1', 'P2': 'tag-p2', 'P3': 'tag-p3',
                        '可能来': 'tag-maybe', '当天新增': 'tag-today'
                    };
                    
                    let actionBtn = '';
                    if (order.status === 'designing') {
                        actionBtn = `<button class="btn btn-primary btn-sm" onclick="submitReview('${order.id}')">提交内审</button>`;
                    } else if (order.status === 'revise') {
                        actionBtn = `<button class="btn btn-primary btn-sm" onclick="submitReview('${order.id}')">修改完成，提交客户</button>`;
                    } else if (order.status === 'review') {
                        actionBtn = `<span style="color:#f97316;font-size:13px">⏳ 等待内审</span>`;
                    } else if (order.status === 'client') {
                        actionBtn = `<span style="color:#8b5cf6;font-size:13px">⏳ 等待客户反馈</span>`;
                    } else if (order.status === 'pending') {
                        actionBtn = `<span style="color:#8f959e;font-size:13px">⏳ 等待分配</span>`;
                    }
                    
                    return `
                        <div class="order-card status-${order.status}">
                            <div class="order-header">
                                <div>
                                    <div class="order-name">【${order.workType}】${order.projectName}</div>
                                    <div style="margin-top:4px">
                                        <span class="tag ${priorityTags[order.priority] || 'tag-p2'}">${order.priority}</span>
                                        <span class="tag-status ${statusClasses[order.status]}">${statusLabels[order.status]}</span>
                                        ${order.version > 1 ? `<span style="font-size:12px;color:#ec4899;margin-left:6px">v${order.version}</span>` : ''}
                                    </div>
                                </div>
                            </div>
                            <div class="order-meta">
                                <div>客户：${order.customer} · ${order.dept}</div>
    
                                <div>交付物：${order.deliverType} ${order.size} ${order.quantity}${order.unit}</div>
                                <div>说明：${order.desc || '无'}</div>
                                ${order.copyContent ? `<div style="background:#f2f3ff;padding:8px;border-radius:4px;margin-top:4px">📄 文案：${order.copyContent}</div>` : ''}
                                ${order.makeDate ? `<div>制作日期：${order.makeDate}</div>` : ''}
                            </div>
                            <div class="order-actions">
                                ${actionBtn}
                            </div>
                        </div>
                    `;
                }).join('')}
            `;
        }

        // 内审台
        function renderReview(container) {
            const reviewOrders = orders.filter(o => o.status === 'review');
            
            if (reviewOrders.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="icon">⭕</div>
                        <div>暂无待内审工单</div>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = `
                <div style="margin-bottom:12px;font-size:13px;color:#646a73">
                    待审核: ${reviewOrders.length}件
                </div>
                ${reviewOrders.map(order => `
                    <div class="order-card status-review">
                        <div class="order-header">
                            <div>
                                <div class="order-name">【${order.workType}】${order.projectName} v${order.version}</div>
                                <div style="margin-top:4px">
                                    <span class="tag tag-p0">${order.priority}</span>
                                    <span class="tag-status status-review">待内审</span>
                                </div>
                            </div>
                        </div>
                        <div class="order-meta">
                            <div>设计师：${order.designer}</div>
                            <div>AE：${order.ae}</div>
                            <div>指定内审员：${order.reviewer || '未指定'}</div>
                            <div>客户：${order.customer} · ${order.dept}</div>
                            <div>说明：${order.desc || '无'}</div>
                            ${order.copyContent ? `<div>文案：${order.copyContent}</div>` : ''}
                            ${order.fonts.length ? `<div>字体：${order.fonts.join('、')}</div>` : ''}
                            ${order.materialSource.length ? `<div>素材：${order.materialSource.join('、')}</div>` : ''}
                            ${order.materialDesc ? `<div>素材说明：${order.materialDesc}</div>` : ''}
                            ${order.portrait ? `<div>肖像权：${order.portrait}</div>` : ''}
                        </div>
                        <div class="order-actions">
                            <button class="btn btn-success btn-sm" onclick="passReview('${order.id}')">通过并提交客户</button>
                            <button class="btn btn-secondary btn-sm" onclick="exemptReview('${order.id}')">免审提交客户</button>
                            <button class="btn btn-danger btn-sm" onclick="rejectReview('${order.id}')">需修改</button>
                        </div>
                    </div>
                `).join('')}
            `;
        }

        // 客户反馈
        function renderFeedback(container) {
            const feedbackOrders = orders.filter(o => o.status === 'client' || o.status === 'revise');
            
            if (feedbackOrders.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="icon">📤</div>
                        <div>暂无待客户反馈工单</div>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = `
                <div style="margin-bottom:12px;font-size:13px;color:#646a73">
                    待反馈: ${feedbackOrders.length}件
                </div>
                ${feedbackOrders.map(order => {
                    const isClient = order.status === 'client';
                    return `
                        <div class="order-card status-${order.status}">
                            <div class="order-header">
                                <div>
                                    <div class="order-name">【${order.workType}】${order.projectName} v${order.version}</div>
                                    <div style="margin-top:4px">
                                        <span class="tag tag-p0">${order.priority}</span>
                                        <span class="tag-status ${isClient ? 'status-client' : 'status-revise'}">${isClient ? '提交客户' : '客户修改中'}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="order-meta">
                                <div>AE：${order.ae}</div>
                                <div>设计师：${order.designer}</div>
                                <div>客户：${order.customer} · ${order.dept}</div>
                                <div>内审：${order.internalStatus === 'approved' ? '内部通过' : '内部免审'}</div>
    
                            </div>
                            ${isClient ? `
                                <div class="order-actions">
                                    <button class="btn btn-success btn-sm" onclick="clientConfirm('${order.id}')">客户确认通过</button>
                                    <button class="btn btn-warning btn-sm" onclick="clientRevise('${order.id}')">客户要求修改</button>
                                </div>
                            ` : `
                                <div class="order-actions">
                                    <span style="color:#ec4899;font-size:13px">⏳ 等待设计师修改完成</span>
                                    <button class="btn btn-secondary btn-sm" onclick="changeDesigner('${order.id}')">更换设计师</button>
                                </div>
                            `}
                        </div>
                    `;
                }).join('')}
            `;
        }

        // 排班看板
        function renderKanban(container) {
            // 使用本地日期，避免UTC时区问题
            const now = new Date();
            const filterDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
            
            // 所有人员作为列
            const allPeople = ['待分配', ...ALL_STAFF];
            
            // 按人员分组
            const peopleGroups = {};
            allPeople.forEach(p => peopleGroups[p] = []);
            
            orders.filter(o => o.status !== 'done' && o.status !== 'cancelled').forEach(order => {
                const person = order.designer || '待分配';
                if (!peopleGroups[person]) peopleGroups[person] = [];
                peopleGroups[person].push(order);
            });
            
            const priorityOrder = { 'P0': 0, 'P1': 1, 'P2': 2, 'P3': 3, '可能来': 4, '当天新增': 5 };
            
            container.innerHTML = `
                <div class="kanban-filter-bar">
                    <input type="date" id="kanbanFilterDate" value="${filterDate}" style="min-width:140px">
                    <select id="kanbanFilterPriority">
                        <option value="">全部优先级</option>
                        <option value="P0">P0</option>
                        <option value="P1">P1</option>
                        <option value="P2">P2</option>
                    </select>
                    <input type="text" id="kanbanSearch" placeholder="搜索项目..." style="min-width:200px">
                    <button class="btn btn-primary btn-sm" onclick="showKanbanEditHelp()">💡 操作提示</button>
                </div>
                <div class="kanban-board" id="kanbanBoard">
                    ${allPeople.map(person => {
                        let personOrders = peopleGroups[person] || [];
                        
                        // 排序
                        personOrders.sort((a, b) => {
                            const pa = priorityOrder[a.priority] ?? 99;
                            const pb = priorityOrder[b.priority] ?? 99;
                            if (pa !== pb) return pa - pb;
                            return (a.planDate || '').localeCompare(b.planDate || '');
                        });
                        
                        const isDesigner = DESIGNERS.includes(person);
                        const isOther = OTHER_STAFF.includes(person);
                        const headerColor = person === '待分配' ? '#8f959e' : (isDesigner ? '#3370ff' : '#f59e0b');
                        
                        return `
                            <div class="kanban-column" data-person="${person}" ondragover="allowDrop(event)" ondrop="dropCard(event, '${person}')">
                                <div class="kanban-column-header" style="color:${headerColor}">
                                    <span>${person} ${isDesigner ? '(设计)' : isOther ? '(策划/AE)' : ''}</span>
                                    <span class="kanban-column-count">${personOrders.length}</span>
                                </div>
                                <div class="kanban-cards">
                                    ${personOrders.map(order => {
                                        const priorityColors = {
                                            'P0': '#f54a45', 'P1': '#f97316', 'P2': '#0ea5e9',
                                            'P3': '#22c55e', '可能来': '#8b5cf6', '当天新增': '#ec4899'
                                        };
                                        const statusLabels = {
                                            'pending_copy': '待文案', 'pending': '待分配', 'designing': '设计中',
                                            'review': '待内审', 'client': '提交客户', 'revise': '客户修改'
                                        };
                                        return `
                                            <div class="kanban-card" draggable="true" data-id="${order.id}" ondragstart="dragStart(event, '${order.id}')">
                                                <div class="kanban-card-title">【${order.workType}】${order.projectName}</div>
                                                <div class="kanban-card-meta">
                                                    <div>${order.customer} · ${order.dept}</div>
                                                    <div>交付物：${order.deliverType || '-'} ${order.size || ''} ${order.quantity || ''}${order.unit || ''}</div>
                                                    <div style="margin-top:4px;color:#1f2329">${order.desc || '无说明'}</div>
                                                    ${order.makeDate ? `<div>制作：${order.makeDate}</div>` : ''}
                                                </div>
                                                <div class="kanban-card-tags">
                                                    <span class="kanban-card-tag" style="background:${priorityColors[order.priority] || '#8f959e'}15;color:${priorityColors[order.priority] || '#8f959e'}">${order.priority}</span>
                                                    <span class="kanban-card-tag" style="background:#f2f3f5;color:#646a73">${statusLabels[order.status] || order.status}</span>
                                                    ${order.version > 1 ? `<span class="kanban-card-tag" style="background:#fdf2f8;color:#ec4899">v${order.version}</span>` : ''}
                                                </div>
                                                <div class="kanban-card-actions">
                                                    <button class="btn btn-secondary btn-sm" onclick="editKanbanOrder('${order.id}')" style="flex:1">编辑</button>
                                                    ${person === '待分配' ? `<button class="btn btn-primary btn-sm" onclick="assignFromKanban('${order.id}')" style="flex:1">分配</button>` : ''}
                                                </div>
                                            </div>
                                        `;
                                    }).join('')}
                                    ${personOrders.length === 0 ? '<div style="text-align:center;padding:24px;color:#8f959e;font-size:13px">暂无工单</div>' : ''}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;
        }

        // AE汇总
        function renderSummary(container) {
            const customers = [...new Set(orders.map(o => o.customer))];
            
            container.innerHTML = `
                <div class="card">
                    <div class="card-title">📊 AE项目汇总</div>
                    <div class="form-row" style="margin-bottom:16px">
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">选择客户</label>
                            <select id="summaryCustomer">
                                <option value="">全部客户</option>
                                ${customers.map(c => `<option value="${c}">${c}</option>`).join('')}
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;display:flex;align-items:flex-end;gap:8px">
                            <button class="btn btn-primary" onclick="exportSummary()">📥 导出Excel</button>
                            <button class="btn btn-secondary" onclick="showSummaryHelp()">💡 编辑说明</button>
                        </div>
                    </div>
                    <div style="margin-bottom:12px">
                        <button class="btn btn-secondary btn-sm" onclick="toggleColumnSelector()">🔧 显示/隐藏列</button>
                        <div id="columnSelector" style="display:none;margin-top:12px;padding:12px;background:#f8f9fa;border-radius:6px">
                            <div style="font-weight:600;margin-bottom:8px">选择要显示的列：</div>
                            <div style="display:flex;flex-wrap:wrap;gap:12px">
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="id" checked> 项目编号</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="projectName" checked> 项目简述</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="customer" checked> 客户</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="dept" checked> 部门</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="workType" checked> 工作性质</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="deliverType"> 交付物</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="size"> 规格尺寸</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="quantity"> 数量</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="unit"> 单位</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="orderDate" checked> 下单日期</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="planDate" checked> 计划交付</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="makeDate"> 制作日期</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="designer" checked> 设计师</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="ae"> AE</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="status" checked> 状态</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="version"> 版本</label>
                                <label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" class="col-toggle" value="driveLink" checked> 交付物链接</label>
                            </div>
                            <button class="btn btn-primary btn-sm" onclick="applyColumnToggle()" style="margin-top:12px">应用</button>
                        </div>
                    </div>
                    <div id="summaryTableContainer">
                        ${renderSummaryTable('')}
                    </div>
                </div>
            `;
            
            document.getElementById('summaryCustomer').addEventListener('change', function() {
                document.getElementById('summaryTableContainer').innerHTML = renderSummaryTable(this.value);
            });
        }

        // 默认显示的列
        const DEFAULT_VISIBLE_COLS = ['id', 'projectName', 'customer', 'dept', 'workType', 'orderDate', 'planDate', 'designer', 'status', 'driveLink'];
        let visibleCols = [...DEFAULT_VISIBLE_COLS];

        function renderSummaryTable(customerFilter) {
            const filtered = customerFilter ? orders.filter(o => o.customer === customerFilter) : orders;
            
            if (filtered.length === 0) {
                return '<div class="empty-state"><div class="icon">📋</div><div>暂无工单</div></div>';
            }
            
            const statusLabels = {
                'pending_copy': '待文案', 'pending': '待分配', 'designing': '设计中',
                'review': '待内审', 'client': '提交客户', 'revise': '客户修改',
                'done': '正稿交付', 'cancelled': '已取消'
            };
            
            const colDefs = {
                id: { title: '项目编号', locked: true, render: o => o.id },
                projectName: { title: '项目简述', locked: true, render: o => o.projectName },
                customer: { title: '客户', locked: true, render: o => o.customer },
                dept: { title: '部门', locked: true, render: o => o.dept },
                workType: { title: '工作性质', locked: true, render: o => o.workType },
                deliverType: { title: '交付物', locked: true, render: o => `${o.deliverType} ${o.size} ${o.quantity}${o.unit}` },
                size: { title: '规格尺寸', locked: true, render: o => o.size },
                quantity: { title: '数量', locked: true, render: o => o.quantity },
                unit: { title: '单位', locked: true, render: o => o.unit },
                orderDate: { title: '下单日期', locked: true, render: o => o.orderDate },
                planDate: { title: '计划交付', locked: true, render: o => o.planDate },
                makeDate: { title: '制作日期', locked: true, render: o => o.makeDate || '' },
                designer: { title: '设计师', locked: true, render: o => o.designer || '待分配' },
                ae: { title: 'AE', locked: true, render: o => o.ae },
                status: { title: '状态', locked: true, render: o => statusLabels[o.status] || o.status },
                version: { title: '版本', locked: true, render: o => 'v' + o.version },
                driveLink: { title: '交付物链接<br><span style="font-size:11px;color:#8f959e">(AE可编辑)</span>', locked: false, render: o => `<input type="text" class="editable" value="${o.driveLink}" onchange="updateDriveLink('${o.id}', this.value)" placeholder="正稿交付后填写网盘链接">` }
            };
            
            const visibleColDefs = visibleCols.filter(k => colDefs[k]).map(k => colDefs[k]);
            
            return `
                <div style="overflow-x:auto">
                    <table class="ae-summary-table" id="exportTable">
                        <thead>
                            <tr>
                                ${visibleColDefs.map(c => `<th>${c.title}</th>`).join('')}
                            </tr>
                        </thead>
                        <tbody>
                            ${filtered.map(order => `
                                <tr data-id="${order.id}">
                                    ${visibleColDefs.map(c => `<td class="${c.locked ? 'locked' : ''}">${c.render(order)}</td>`).join('')}
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
                <div style="margin-top:12px;font-size:13px;color:#646a73">
                    共 ${filtered.length} 条记录 · 灰色背景列为系统锁定，不可修改 · 白色列支持AE编辑
                </div>
            `;
        }

        // 基础数据管理
        function renderAdmin(container) {
            container.innerHTML = `
                <div class="card">
                    <div class="card-title">⚙️ 基础数据管理</div>
                    <div class="data-tabs">
                        <div class="data-tab active" onclick="switchAdminTab('customers')">客户部门</div>
                        <div class="data-tab" onclick="switchAdminTab('fonts')">字体白名单</div>
                        <div class="data-tab" onclick="switchAdminTab('staff')">人员管理</div>
                    </div>
                    <div id="adminContent"></div>
                </div>
            `;
            renderAdminCustomers();
        }

        function renderAdminCustomers() {
            const content = document.getElementById('adminContent');
            content.innerHTML = `
                <div style="margin-bottom:12px">
                    <button class="btn btn-primary btn-sm" onclick="addCustomer()">+ 新增客户</button>
                </div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>客户名称</th>
                            <th>下属部门</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${CUSTOMERS_DATA.map((c, idx) => `
                            <tr>
                                <td><input type="text" value="${c.name}" onchange="updateCustomer(${idx}, 'name', this.value)" style="width:100%"></td>
                                <td>
                                    <textarea onchange="updateCustomer(${idx}, 'depts', this.value)" rows="2" style="width:100%;min-height:60px">${c.depts.join('、')}</textarea>
                                    <div class="form-hint">用"、"分隔多个部门</div>
                                </td>
                                <td>
                                    <button class="btn btn-danger btn-sm" onclick="deleteCustomer(${idx})">删除</button>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        function renderAdminFonts() {
            const content = document.getElementById('adminContent');
            content.innerHTML = `
                <div style="margin-bottom:12px">
                    <button class="btn btn-primary btn-sm" onclick="addFont()">+ 新增字体</button>
                </div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>字体名称</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${FONTS_DATA.map((f, idx) => `
                            <tr>
                                <td><input type="text" value="${f}" onchange="updateFont(${idx}, this.value)" style="width:100%"></td>
                                <td>
                                    <button class="btn btn-danger btn-sm" onclick="deleteFont(${idx})">删除</button>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        function renderAdminStaff() {
            const content = document.getElementById('adminContent');
            content.innerHTML = `
                <div class="card" style="margin-bottom:12px">
                    <div style="font-weight:600;margin-bottom:8px">设计团队</div>
                    <div style="display:flex;flex-wrap:wrap;gap:8px">
                        ${DESIGNERS.map(d => `<span class="font-tag">${d}</span>`).join('')}
                    </div>
                </div>
                <div class="card" style="margin-bottom:12px">
                    <div style="font-weight:600;margin-bottom:8px">策划/AE/其他</div>
                    <div style="display:flex;flex-wrap:wrap;gap:8px">
                        ${OTHER_STAFF.map(s => `<span class="font-tag">${s}</span>`).join('')}
                    </div>
                </div>
                <div class="card">
                    <div style="font-weight:600;margin-bottom:8px">内审员</div>
                    <div style="display:flex;flex-wrap:wrap;gap:8px">
                        ${REVIEWERS.map(r => `<span class="font-tag" style="background:#fff7ed;color:#f97316">${r}</span>`).join('')}
                    </div>
                </div>
                <div class="form-hint" style="margin-top:12px">
                    人员管理需联系系统管理员修改代码配置。当前为演示模式，正式环境支持动态管理。
                </div>
            `;
        }

        // ==================== 操作函数 ====================
        window.submitCopy = async function(orderId) {
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            const content = document.getElementById(`copyContent_${orderId}`)?.value || '';
            if (!content.trim()) {
                showToast('请先填写文案内容');
                return;
            }
            try {
                const newStatus = order.designer ? 'designing' : 'pending';
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    copyContent: content,
                    status: newStatus
                });
                // 更新本地数据
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast('文案已提交，进入设计流程');
                render();
            } catch (e) {
                showToast('提交失败: ' + e.message);
            }
        };

        window.submitReview = function(orderId) {
            const order = orders.find(o => o.id === orderId);
            if (!order) return;
            
            const modal = document.createElement('div');
            modal.className = 'modal-overlay';
            modal.innerHTML = `
                <div class="modal">
                    <div class="modal-header">
                        <h3>提交内审：${order.projectName}</h3>
                        <button class="modal-close" onclick="this.closest('.modal-overlay').remove()">×</button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label">上传设计稿预览</label>
                            <div class="preview-area" onclick="showToast('演示模式：实际环境支持文件上传')">
                                <div style="font-size:24px;margin-bottom:8px">📎</div>
                                <div>点击或拖拽上传设计稿</div>
                                <div style="font-size:12px;color:#8f959e;margin-top:4px">支持 JPG, PNG, PDF</div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">使用字体（支持搜索）</label>
                            <div class="search-input">
                                <input type="text" id="fontSearch" placeholder="输入字体名称搜索..." autocomplete="off">
                            </div>
                            <div class="font-search-results" id="fontSearchResults" style="display:none"></div>
                            <div class="font-selected-tags" id="fontSelectedTags"></div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">素材来源（多选）</label>
                            <div class="checkbox-group">
                                <label class="checkbox-item"><input type="checkbox" value="原创" class="material-checkbox"> 原创</label>
                                <label class="checkbox-item"><input type="checkbox" value="正版素材库" class="material-checkbox"> 正版素材库</label>
                                <label class="checkbox-item"><input type="checkbox" value="客户提供" class="material-checkbox"> 客户提供</label>
                                <label class="checkbox-item"><input type="checkbox" value="AI生成" class="material-checkbox"> AI生成</label>
                                <label class="checkbox-item"><input type="checkbox" value="免费商用" class="material-checkbox"> 免费商用</label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">素材说明</label>
                            <textarea id="materialDesc" placeholder="如：原创插画+采购背景"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">肖像权</label>
                            <div class="radio-group" id="portraitGroup">
                                <div class="radio-item selected" data-value="无">无</div>
                                <div class="radio-item" data-value="有-待确认">有-待确认</div>
                                <div class="radio-item" data-value="有-已获得肖像授权">有-已获得肖像授权</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" onclick="this.closest('.modal-overlay').remove()">取消</button>
                        <button class="btn btn-primary" id="confirmSubmit">确认提交</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            
            let selectedFonts = [];
            const fontSearchInput = modal.querySelector('#fontSearch');
            const fontResults = modal.querySelector('#fontSearchResults');
            const fontTags = modal.querySelector('#fontSelectedTags');
            
            function updateFontTags() {
                fontTags.innerHTML = selectedFonts.map(f => `
                    <span class="font-tag">${f} <span class="remove" onclick="removeFont('${f}')">×</span></span>
                `).join('');
            }
            
            window.removeFont = function(font) {
                selectedFonts = selectedFonts.filter(f => f !== font);
                updateFontTags();
            };
            
            fontSearchInput.addEventListener('input', function() {
                const query = this.value.trim().toLowerCase();
                if (!query) {
                    fontResults.style.display = 'none';
                    return;
                }
                const matches = FONTS_DATA.filter(f => f.toLowerCase().includes(query) && !selectedFonts.includes(f)).slice(0, 10);
                if (matches.length) {
                    fontResults.innerHTML = matches.map(f => `
                        <div class="font-search-item" data-font="${f}">
                            <span>${f}</span>
                            <span style="font-size:12px;color:#3370ff">+ 添加</span>
                        </div>
                    `).join('');
                    fontResults.style.display = 'block';
                    
                    fontResults.querySelectorAll('.font-search-item').forEach(item => {
                        item.addEventListener('click', function() {
                            const font = this.dataset.font;
                            if (!selectedFonts.includes(font)) {
                                selectedFonts.push(font);
                                updateFontTags();
                            }
                            fontSearchInput.value = '';
                            fontResults.style.display = 'none';
                        });
                    });
                } else {
                    fontResults.innerHTML = '<div style="padding:12px;color:#8f959e">无匹配字体</div>';
                    fontResults.style.display = 'block';
                }
            });
            
            modal.querySelectorAll('#portraitGroup .radio-item').forEach(item => {
                item.addEventListener('click', function() {
                    modal.querySelectorAll('#portraitGroup .radio-item').forEach(i => i.classList.remove('selected'));
                    this.classList.add('selected');
                });
            });
            
            modal.querySelector('#confirmSubmit').addEventListener('click', async function() {
                const materials = Array.from(modal.querySelectorAll('.material-checkbox:checked')).map(cb => cb.value);
                const portrait = modal.querySelector('#portraitGroup .selected').dataset.value;
                
                try {
                    const result = await apiPut(`/api/orders/${order.recordId}`, {
                        status: 'review',
                        reviewer: order.reviewer || '',
                        fonts: selectedFonts,
                        materialSource: materials,
                        materialDesc: modal.querySelector('#materialDesc').value,
                        portrait: portrait,
                        designerSubmitted: true
                    });
                    const idx = orders.findIndex(o => o.recordId === order.recordId);
                    if (idx >= 0) orders[idx] = result;
                    modal.remove();
                    showToast('已提交内审，等待审核');
                    render();
                } catch (e) {
                    showToast('提交失败: ' + e.message);
                }
            });
        };

        window.passReview = async function(orderId) {
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            try {
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    status: 'client',
                    internalStatus: 'approved'
                });
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast(`内审通过，已通知AE ${order.ae} 提交客户`);
                render();
            } catch (e) {
                showToast('操作失败: ' + e.message);
            }
        };

        window.exemptReview = async function(orderId) {
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            try {
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    status: 'client',
                    internalStatus: 'exempt'
                });
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast(`免审通过，已通知AE ${order.ae} 提交客户`);
                render();
            } catch (e) {
                showToast('操作失败: ' + e.message);
            }
        };

        window.rejectReview = async function(orderId) {
            const comment = prompt('请输入修改意见：');
            if (!comment) return;
            
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            try {
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    status: 'designing',
                    internalStatus: 'revising'
                });
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast(`已退回修改，通知设计师 ${order.designer}`);
                render();
            } catch (e) {
                showToast('操作失败: ' + e.message);
            }
        };

        window.clientConfirm = async function(orderId) {
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            
            // 弹出填写交付物链接
            const link = prompt('请填写交付物网盘链接（归档用）：', order.driveLink);
            if (link === null) return; // 用户取消
            
            try {
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    status: 'done',
                    driveLink: link || order.driveLink
                });
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast('已确认正稿交付，流程完结');
                render();
            } catch (e) {
                showToast('操作失败: ' + e.message);
            }
        };

        window.clientRevise = async function(orderId) {
            const comment = prompt('请输入客户修改意见：');
            if (!comment) return;
            
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            try {
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    status: 'revise'
                });
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast(`客户要求修改，版本升至 v${result.version}`);
                render();
            } catch (e) {
                showToast('操作失败: ' + e.message);
            }
        };

        window.changeDesigner = async function(orderId) {
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            
            const newDesigner = prompt(`当前设计师：${order.designer}\n请输入新设计师（${DESIGNERS.join('、')}）：`);
            if (!newDesigner || !DESIGNERS.includes(newDesigner)) {
                showToast('设计师名称无效');
                return;
            }
            
            try {
                const now = new Date();
                const makeDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    designer: newDesigner,
                    makeDate: makeDate
                });
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast(`已更换设计师为 ${newDesigner}`);
                render();
            } catch (e) {
                showToast('操作失败: ' + e.message);
            }
        };

        // 排班看板拖拽
        window.dragStart = function(event, orderId) {
            event.dataTransfer.setData('text/plain', orderId);
            event.target.classList.add('dragging');
        };

        window.allowDrop = function(event) {
            event.preventDefault();
            event.currentTarget.classList.add('drag-over');
        };

        window.dropCard = async function(event, person) {
            event.preventDefault();
            event.currentTarget.classList.remove('drag-over');
            
            const orderId = event.dataTransfer.getData('text/plain');
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            
            if (person === '待分配') {
                try {
                    const result = await apiPut(`/api/orders/${order.recordId}`, {
                        designer: '',
                        status: 'pending'
                    });
                    const idx = orders.findIndex(o => o.recordId === order.recordId);
                    if (idx >= 0) orders[idx] = result;
                    showToast('已取消分配');
                    render();
                } catch (e) {
                    showToast('操作失败: ' + e.message);
                }
            } else if (DESIGNERS.includes(person)) {
                try {
                    const now = new Date();
                    const makeDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
                    const updates = {
                        designer: person,
                        makeDate: makeDate
                    };
                    if (order.status === 'pending') updates.status = 'designing';
                    
                    const result = await apiPut(`/api/orders/${order.recordId}`, updates);
                    const idx = orders.findIndex(o => o.recordId === order.recordId);
                    if (idx >= 0) orders[idx] = result;
                    showToast('已分配给 ' + person);
                    render();
                } catch (e) {
                    showToast('分配失败: ' + e.message);
                }
            } else {
                showToast('只能分配给设计师');
                return;
            }
        };

        // 清除拖拽样式
        document.addEventListener('dragend', function(e) {
            if (e.target.classList.contains('kanban-card')) {
                e.target.classList.remove('dragging');
            }
            document.querySelectorAll('.kanban-column').forEach(col => col.classList.remove('drag-over'));
        });

        window.editKanbanOrder = function(orderId) {
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            
            const modal = document.createElement('div');
            modal.className = 'modal-overlay';
            modal.innerHTML = `
                <div class="modal">
                    <div class="modal-header">
                        <h3>编辑工单：${order.projectName}</h3>
                        <button class="modal-close" onclick="this.closest('.modal-overlay').remove()">×</button>
                    </div>
                    <div class="modal-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">优先级</label>
                                <select id="editPriority">
                                    <option value="P0" ${order.priority === 'P0' ? 'selected' : ''}>P0</option>
                                    <option value="P1" ${order.priority === 'P1' ? 'selected' : ''}>P1</option>
                                    <option value="P2" ${order.priority === 'P2' ? 'selected' : ''}>P2</option>
                                    <option value="P3" ${order.priority === 'P3' ? 'selected' : ''}>P3</option>
                                    <option value="可能来" ${order.priority === '可能来' ? 'selected' : ''}>可能来</option>
                                    <option value="当天新增" ${order.priority === '当天新增' ? 'selected' : ''}>当天新增</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">制作日期</label>
                                <input type="date" id="editMakeDate" value="${order.makeDate || ''}">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">说明</label>
                            <textarea id="editDesc" rows="3">${order.desc || ''}</textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">计划交付日期</label>
                            <input type="date" id="editPlanDate" value="${order.planDate}">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" onclick="this.closest('.modal-overlay').remove()">取消</button>
                        <button class="btn btn-primary" id="saveEdit">保存</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            
            modal.querySelector('#saveEdit').addEventListener('click', async function() {
                try {
                    const result = await apiPut(`/api/orders/${order.recordId}`, {
                        priority: modal.querySelector('#editPriority').value,
                        makeDate: modal.querySelector('#editMakeDate').value,
                        desc: modal.querySelector('#editDesc').value,
                        planDate: modal.querySelector('#editPlanDate').value
                    });
                    const idx = orders.findIndex(o => o.recordId === order.recordId);
                    if (idx >= 0) orders[idx] = result;
                    modal.remove();
                    showToast('工单已更新');
                    render();
                } catch (e) {
                    showToast('更新失败: ' + e.message);
                }
            });
        };

        window.assignFromKanban = async function(orderId) {
            const order = orders.find(o => o.id === orderId || o.recordId === orderId);
            if (!order) return;
            
            const designer = prompt(`为工单【${order.projectName}】分配设计师（${DESIGNERS.join('、')}）：`);
            if (!designer || !DESIGNERS.includes(designer)) {
                showToast('设计师名称无效');
                return;
            }
            
            try {
                const now = new Date();
                const makeDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
                const result = await apiPut(`/api/orders/${order.recordId}`, {
                    designer: designer,
                    status: 'designing',
                    makeDate: makeDate
                });
                const idx = orders.findIndex(o => o.recordId === order.recordId);
                if (idx >= 0) orders[idx] = result;
                showToast(`已分配给 ${designer}`);
                render();
            } catch (e) {
                showToast('分配失败: ' + e.message);
            }
        };

        window.showKanbanEditHelp = function() {
            alert(`排班看板操作说明：

1. 拖拽分配：按住工单卡片，拖拽到目标设计师列，即可重新分配
2. 编辑工单：点击卡片上的"编辑"按钮，可修改优先级、制作日期、说明、交付日期
3. 分配工单：待分配列的卡片点击"分配"按钮，选择设计师

提示：
- 只能拖拽到设计师列（蓝色标记）
- 策划/AE列（橙色标记）不能接收设计工单
- 制作日期用于判断当日排班`);
        };

        // AE汇总
        window.updateDriveLink = async function(orderId, value) {
            const order = orders.find(o => o.id === orderId);
            if (order) {
                try {
                    await apiPut(`/api/orders/${order.recordId}`, {driveLink: value});
                    order.driveLink = value;
                    showToast('交付物链接已更新');
                } catch (e) {
                    showToast('更新失败: ' + e.message);
                }
            }
        };

        window.showSummaryHelp = function() {
            alert(`AE汇总页面编辑说明：

可编辑列（白色背景）：
- 交付物链接：正稿交付后由AE填写网盘地址

锁定列（灰色背景，不可编辑）：
- 项目编号、项目简述、客户、部门
- 工作性质、交付物信息
- 下单日期、计划交付日期
- 设计师、状态、版本号

这些字段由系统自动生成或由其他角色填写，AE不可修改以确保数据一致性。`);
        };

        window.toggleColumnSelector = function() {
            const el = document.getElementById('columnSelector');
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        };

        window.applyColumnToggle = function() {
            const checkboxes = document.querySelectorAll('.col-toggle:checked');
            visibleCols = Array.from(checkboxes).map(cb => cb.value);
            if (visibleCols.length === 0) {
                showToast('至少选择一列');
                return;
            }
            const customerFilter = document.getElementById('summaryCustomer')?.value || '';
            document.getElementById('summaryTableContainer').innerHTML = renderSummaryTable(customerFilter);
            document.getElementById('columnSelector').style.display = 'none';
            showToast('列显示已更新');
        };

        window.exportSummary = function() {
            const customerFilter = document.getElementById('summaryCustomer')?.value || '';
            const filtered = customerFilter ? orders.filter(o => o.customer === customerFilter) : orders;
            
            const statusLabels = {
                'pending_copy': '待文案', 'pending': '待分配', 'designing': '设计中',
                'review': '待内审', 'client': '提交客户', 'revise': '客户修改',
                'done': '正稿交付', 'cancelled': '已取消'
            };
            
            const colHeaders = {
                id: '项目编号', projectName: '项目简述', customer: '客户', dept: '部门',
                workType: '工作性质', deliverType: '交付物', size: '规格尺寸', quantity: '数量', unit: '单位',
                orderDate: '下单日期', planDate: '计划交付', makeDate: '制作日期',
                designer: '设计师', ae: 'AE', status: '状态', version: '版本', driveLink: '交付物链接'
            };
            const colRender = {
                id: o => o.id, projectName: o => o.projectName, customer: o => o.customer, dept: o => o.dept,
                workType: o => o.workType, deliverType: o => `${o.deliverType} ${o.size} ${o.quantity}${o.unit}`,
                size: o => o.size, quantity: o => o.quantity, unit: o => o.unit,
                orderDate: o => o.orderDate, planDate: o => o.planDate, makeDate: o => o.makeDate || '',
                designer: o => o.designer || '待分配', ae: o => o.ae,
                status: o => statusLabels[o.status] || o.status, version: o => 'v' + o.version, driveLink: o => o.driveLink || ''
            };
            const headers = visibleCols.filter(k => colHeaders[k]).map(k => colHeaders[k]);
            const rows = filtered.map(order => visibleCols.filter(k => colRender[k]).map(k => colRender[k](order)));
            
            let csv = '\uFEFF' + headers.join(',') + '\n';
            rows.forEach(row => {
                csv += row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',') + '\n';
            });
            
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            const now = new Date();
            const dateStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
            link.download = `AE项目汇总_${dateStr}.csv`;
            link.click();
            
            showToast('已导出CSV文件（可用Excel打开）');
        };

        // 基础数据管理
        window.switchAdminTab = function(tab) {
            document.querySelectorAll('.data-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            
            if (tab === 'customers') renderAdminCustomers();
            else if (tab === 'fonts') renderAdminFonts();
            else if (tab === 'staff') renderAdminStaff();
        };

        window.addCustomer = async function() {
            try {
                const result = await apiPost('/api/customers/', { name: '新客户', depts: ['默认部门'] });
                CUSTOMERS_DATA.push({ name: result.name || '新客户', depts: result.depts || ['默认部门'], recordId: result.recordId });
                renderAdminCustomers();
                showToast('已添加新客户');
            } catch (e) {
                showToast('添加失败: ' + e.message);
            }
        };

        window.updateCustomer = async function(idx, field, value) {
            if (field === 'name') {
                CUSTOMERS_DATA[idx].name = value;
            } else if (field === 'depts') {
                CUSTOMERS_DATA[idx].depts = value.split('、').map(d => d.trim()).filter(Boolean);
            }
            try {
                const customer = CUSTOMERS_DATA[idx];
                if (customer.recordId) {
                    await apiPut(`/api/customers/${customer.recordId}`, {
                        name: customer.name,
                        depts: customer.depts
                    });
                }
            } catch (e) {
                console.error('保存客户失败:', e);
            }
        };

        window.deleteCustomer = async function(idx) {
            if (!confirm('确定删除该客户？')) return;
            const customer = CUSTOMERS_DATA[idx];
            try {
                if (customer.recordId) {
                    await apiDelete(`/api/customers/${customer.recordId}`);
                }
                CUSTOMERS_DATA.splice(idx, 1);
                renderAdminCustomers();
                showToast('已删除');
            } catch (e) {
                showToast('删除失败: ' + e.message);
            }
        };

        window.addFont = async function() {
            try {
                const result = await apiPost('/api/fonts/', { name: '新字体' });
                FONTS_DATA.push(result.name || '新字体');
                renderAdminFonts();
                showToast('已添加新字体');
            } catch (e) {
                showToast('添加失败: ' + e.message);
            }
        };

        window.updateFont = async function(idx, value) {
            FONTS_DATA[idx] = value;
            // 字体管理通过API保存（需要字体表配置）
        };

        window.deleteFont = async function(idx) {
            if (!confirm('确定删除该字体？')) return;
            try {
                FONTS_DATA.splice(idx, 1);
                renderAdminFonts();
                showToast('已删除');
            } catch (e) {
                showToast('删除失败: ' + e.message);
            }
        };

        // ==================== 初始化 ====================
        document.addEventListener('DOMContentLoaded', async function() {
            await loadData();
            
            document.getElementById('navTabs').addEventListener('click', function(e) {
                if (e.target.classList.contains('nav-tab')) {
                    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
                    e.target.classList.add('active');
                    currentTab = e.target.dataset.tab;
                    render();
                }
            });
            
            render();
        });
    </script>
</body>
</html>

        // API配置
        const API_BASE = window.location.origin;  // 同域名部署
        let apiConnected = false;
        
        async function apiGet(path) {
            const resp = await fetch(`${API_BASE}${path}`);
            if (!resp.ok) {
                const text = await resp.text();
                throw new Error(`API ${path} 错误: ${resp.status} - ${text}`);
            }
            return resp.json();
        }
        
        async function apiPost(path, data) {
            const resp = await fetch(`${API_BASE}${path}`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            });
            if (!resp.ok) {
                const text = await resp.text();
                throw new Error(`API ${path} 错误: ${resp.status} - ${text}`);
            }
            return resp.json();
        }
        
        async function apiPut(path, data) {
            const resp = await fetch(`${API_BASE}${path}`, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            });
            if (!resp.ok) {
                const text = await resp.text();
                throw new Error(`API ${path} 错误: ${resp.status} - ${text}`);
            }
            return resp.json();
        }
        
        async function apiDelete(path) {
            const resp = await fetch(`${API_BASE}${path}`, {method: 'DELETE'});
            if (!resp.ok) {
                const text = await resp.text();
                throw new Error(`API ${path} 错误: ${resp.status} - ${text}`);
            }
            return resp.json();
        }
        
        function updateConnectionStatus() {
            const userEl = document.getElementById('currentUser');
            if (apiConnected) {
                userEl.innerHTML = '✅ 已连接飞书表格';
                userEl.style.color = '#34d399';
            } else {
                userEl.innerHTML = '⚠️ 演示模式（未连接表格）';
                userEl.style.color = '#f97316';
            }
        }

        async function loadData() {
            try {
                // 先测试后端健康状态
                const health = await apiGet('/health');
                console.log('后端状态:', health);
                
                // 从API加载工单
                orders = await apiGet('/api/orders/');
                
                // 从API加载客户
                const customersResp = await apiGet('/api/customers/');
                if (Array.isArray(customersResp) && customersResp.length > 0) {
                    CUSTOMERS_DATA = customersResp.map(c => ({name: c.name, depts: c.depts}));
                }
                
                // 从API加载字体
                const fontsResp = await apiGet('/api/fonts/');
                if (Array.isArray(fontsResp) && fontsResp.length > 0) {
                    FONTS_DATA = fontsResp.map(f => f.name || f);
                }
                
                // 从API加载人员配置
                const staffResp = await apiGet('/api/fonts/staff');
                if (staffResp) {
                    DESIGNERS.length = 0;
                    DESIGNERS.push(...(staffResp.designers || DESIGNERS));
                    OTHER_STAFF.length = 0;
                    OTHER_STAFF.push(...(staffResp.otherStaff || OTHER_STAFF));
                    ALL_STAFF.length = 0;
                    ALL_STAFF.push(...(staffResp.allStaff || ALL_STAFF));
                    REVIEWERS.length = 0;
                    REVIEWERS.push(...(staffResp.reviewers || REVIEWERS));
                }
                
                apiConnected = true;
                updateConnectionStatus();
                render();
                showToast('已连接飞书表格');
            } catch (e) {
                console.error('加载数据失败:', e);
                apiConnected = false;
                updateConnectionStatus();
                showToast('连接服务器失败: ' + e.message);
                // 不再自动加载演示数据
                orders = [];
                render();
            }
        }

